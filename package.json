{
  "name": "excel-front-fresh",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s generate serve",
    "serve": "bunx --bun vite",
    "build-only": "bunx --bun vite build",
    "build-typecheck": "run-p type-check \"build-only {@}\" --",
    "build": "run-s generate build-only",
    "generate-api-v1": "bun ./src/api/v1/generateApiV1.js",
    "update-api": "bun ./src/api/v1/updateApiV1.ts",
    "generate": "run-p generate-api-v1",
    "preview": "vite preview",
    "test:vtu-jsdom": "vitest run --project=vtu-jsdom",
    "test:vtu-happy-dom": "vitest run --project=vtu-happy-dom",
    "test:vtl-jsdom": "vitest run --project=vtl-jsdom",
    "test:vtl-happy-dom": "vitest run --project=vtl-happy-dom",
    "test:bun": "bun --bun test test/bun",
    "test:vitest": "vitest run",
    "test": "run-p test:vitest test:bun",
    "test:watch": "vitest watch",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint --fix --fix-suggestions -c .oxlintrc.jsonc --tsconfig tsconfig.json",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@kyvg/vue3-notification": "^3.4.1",
    "@tanstack/vue-query": "^5.83.0",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.18",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "bun-types": "^1.2.19",
    "eslint": "^9.32.0",
    "eslint-plugin-oxlint": "^1.8.0",
    "eslint-plugin-vue": "~10.2.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^1.8.0",
    "prettier": "3.5.3",
    "swagger-typescript-api": "~13.0.28",
    "typescript": "~5.8.3",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12",
    "vuetify": "3.9.0"
  },
  "module": "index.ts"
}
