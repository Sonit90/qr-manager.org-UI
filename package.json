{
  "name": "excel-front-fresh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s generate serve",
    "serve": "vite",
    "build-typecheck": "run-p type-check \"build-only {@}\" --",
    "build": "run-s generate build-typecheck",
    "generate-api-v1": "node ./src/api/v1/generateApiV1.js",
    "generate": "run-p generate-api-v1",
    "preview": "vite preview",
    "test:vtu-jsdom": "vitest run --project=vtu-jsdom",
    "test:vtu-happy-dom": "vitest run --project=vtu-happy-dom",
    "test:vtl-jsdom": "vitest run --project=vtl-jsdom",
    "test:vtl-happy-dom": "vitest run --project=vtl-happy-dom",
    "test:bun": "bun --bun test test/bun",
    "test:vitest": "vitest run",
    "test": "run-p test:bun test:vitest",
    "test:watch": "vitest watch",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint --fix --fix-suggestions -c .oxlintrc.jsonc --tsconfig tsconfig.json",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "axios": "^1.9.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "bun-types": "latest",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^1.0.0",
    "eslint-plugin-vue": "~10.2.0",
    "happy-dom": "^18.0.1",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^1.0.0",
    "prettier": "3.5.3",
    "swagger-typescript-api": "~13.0.28",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^3.2.3",
    "vue-tsc": "^2.2.10",
    "vuetify": "^3.8.9"
  },
  "module": "index.ts"
}
