{
  "openapi": "3.1.0",
  "info": {
    "title": "QR Link API",
    "description": "Dynamic QR code management",
    "contact": {
      "name": "QR Link Team"
    },
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/contact": {
      "post": {
        "tags": [
          "Contact"
        ],
        "operationId": "submit_contact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Message accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/v1/qr": {
      "get": {
        "tags": [
          "QR"
        ],
        "operationId": "list_user_qrs",
        "responses": {
          "200": {
            "description": "List user's QR codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QrCodeResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "QR"
        ],
        "operationId": "create_qr",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "QR code created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QrCodeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/qr/{id}": {
      "get": {
        "tags": [
          "QR"
        ],
        "operationId": "get_qr",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "QR code details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QrCodeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "QR"
        ],
        "operationId": "delete_qr",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/qr/{id}/enabled": {
      "patch": {
        "tags": [
          "QR"
        ],
        "operationId": "toggle_qr_enabled",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleEnabledRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "QR enabled state updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleEnabledResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/qr/{id}/name": {
      "patch": {
        "tags": [
          "QR"
        ],
        "operationId": "update_name",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Name updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateNameResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/qr/{id}/scans": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "operationId": "get_scan_logs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/qr/{id}/target": {
      "put": {
        "tags": [
          "QR"
        ],
        "operationId": "update_target_url",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "QR code id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTargetUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Target URL updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetUrlResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/r/{qr_code}": {
      "get": {
        "tags": [
          "Public"
        ],
        "operationId": "redirect_qr",
        "parameters": [
          {
            "name": "qr_code",
            "in": "path",
            "description": "QR code identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to target URL or disabled page"
          },
          "404": {
            "description": "QR code not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactMessageResponse": {
        "type": "object",
        "required": [
          "id",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateContactMessageRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "properties": {
          "captcha_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateQrRequest": {
        "type": "object",
        "required": [
          "target_url"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_url": {
            "type": "string"
          }
        }
      },
      "QrCodeResponse": {
        "type": "object",
        "required": [
          "id",
          "code",
          "target_url",
          "enabled",
          "scan_count",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "scan_count": {
            "type": "integer",
            "format": "int64"
          },
          "target_url": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScanLogResponse": {
        "type": "object",
        "required": [
          "timestamp"
        ],
        "properties": {
          "browser": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScanStatsResponse": {
        "type": "object",
        "required": [
          "total_scans",
          "device_breakdown",
          "browser_breakdown",
          "recent_logs"
        ],
        "properties": {
          "browser_breakdown": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "device_breakdown": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "recent_logs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanLogResponse"
            }
          },
          "total_scans": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TargetUrlResponse": {
        "type": "object",
        "required": [
          "id",
          "url",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ToggleEnabledRequest": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ToggleEnabledResponse": {
        "type": "object",
        "required": [
          "id",
          "enabled",
          "updated_at"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateNameRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "UpdateNameResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateTargetUrlRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "QR",
      "description": "QR code management"
    },
    {
      "name": "Analytics",
      "description": "Scan statistics"
    },
    {
      "name": "Public",
      "description": "Public scan endpoint"
    },
    {
      "name": "Health",
      "description": "Service health check"
    },
    {
      "name": "Contact",
      "description": "Contact form submissions"
    }
  ]
}