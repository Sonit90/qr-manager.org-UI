{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/__tests__/*",
    "env.d.ts",
    "vitest.config.ts",
    "tests/vue-test-utils/**/*",
    "tests/vue-testing-library/**/*"
  ],
  "exclude": [],
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["vitest/globals", "node", "jsdom", "happy-dom"]
  }
}
